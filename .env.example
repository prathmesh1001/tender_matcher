# Copy to backend/.env and adjust. Every variable the backend reads is listed here.
# docker-compose.yml sets DATABASE_URL, the folders and Tesseract itself; they win over this file.

# ---- Docker Compose (set in the shell or a .env next to docker-compose.yml) ----
# Compose does not read these from backend/.env. The same goes for POSTGRES_* further down.
# Host ports (defaults).
# WEB_PORT=8080
# API_PORT=8000
# Existing Hugging Face cache folder on this machine, so the models are not downloaded again.
# HF_CACHE_DIR=C:/Users/you/.cache/huggingface

# ---- Backend: app ----
APP_NAME=Tender Matcher
APP_VERSION=0.1.0
# local | test | production
ENVIRONMENT=local
# Prefix for all API routes, OpenAPI JSON and Swagger docs (docs at ${API_PREFIX}/docs)
API_PREFIX=/api/v1

# ---- Backend: logging ----
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# true = one JSON object per line (production); false = human-readable (dev)
LOG_JSON=true

# ---- Backend: HTTP ----
# JSON list of browser origins allowed to call the API (the frontend's URL)
CORS_ORIGINS=["http://localhost:5173"]

# ---- Backend: database (PostgreSQL + pgvector) ----
# Local dev talks to the docker-compose `db` service, published on host port 5433.
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5433/tender_matcher
# Log every SQL statement (debug only)
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30

# ---- Backend: file store + ingestion ----
# local = files on this machine under FILE_STORE_ROOT; postgres = in the database (run
# `python -m app.cli import-files` once to copy the local files in). Paths stay relative to
# FILE_STORE_ROOT either way; sources.yaml and tender.yaml are always read from disk.
FILE_STORE_BACKEND=local
# Root of the file store; documents record paths relative to it. Relative to backend/.
FILE_STORE_ROOT=../data
# Folder with one sub-folder per manufacturer (PDFs + sources.yaml). Relative to backend/.
MANUFACTURER_DATA_DIR=../data/manufacturers
# Folder with one sub-folder per tender (bid.pdf, linked files, tender.yaml). Relative to backend/.
TENDER_DATA_DIR=../data/tenders
# Folder with one ontology YAML per product category. Relative to backend/.
ONTOLOGY_DIR=ontology
# Processed catalogue files (one JSON per sha256) for matching without the database. Rebuilt
# automatically when chunking code, ontology or settings change. Relative to backend/.
CHUNK_CACHE_DIR=.cache/chunks
# The API reads every catalogue into that cache when it starts, so runs never wait for it
CATALOGUE_WARM_ON_STARTUP=true
# Dummy embed + rerank calls in that startup warm-up (when the LLM judge is on), so the first run
# after a restart does not spend minutes loading the models (0: load them in the first run)
MODEL_WARM_UP_CALLS=3
# Where match-tender writes JSON reports. Relative to backend/.
REPORT_DIR=.cache/reports
# Untagged chunks inherit their page's product type only when at least this many chunks on the
# page were tagged, all with the same type (one passing mention on an overview page is not enough)
PRODUCT_PAGE_MIN_TAGGED=2
# A table ending/starting within this fraction of the page height may continue on the next page
TABLE_CONTINUATION_EDGE_FRACTION=0.25
# Tables drawn with thin filled rectangles (no stroked lines) are rebuilt from those rules:
# shapes at most THICKNESS points thick are rules; edges closer than TOLERANCE are one edge;
# a grid needs MIN_COLUMNS columns and MIN_ROWS row bands to count as a table
LAYOUT_RULE_MAX_THICKNESS=2.0
LAYOUT_RULE_TOLERANCE=2.0
LAYOUT_GRID_MIN_COLUMNS=2
LAYOUT_GRID_MIN_ROWS=3
# Pages with more thin shapes than this are drawings or outlined text, never rule tables
LAYOUT_MAX_RULES=2000
# Longest column label in words; a longer header cell with commas is a caption (a title
# sentence read as the header), used as the section of the table's rows
TABLE_HEADER_MAX_WORDS=8
# A line gap this many times a table cell's median line pitch starts a new paragraph
TABLE_PARAGRAPH_GAP_FACTOR=1.5
# Let PyMuPDF's layout model gate table detection (~7 s/page; false = faster, less accurate)
TABLE_USE_LAYOUT=true

# ---- Backend: tender requirements ----
# Header labels of a tender schedule's columns (JSON lists, matched on folded words);
# quantity entries are word prefixes ("quant" matches "Quantity" and "Quantiry")
TENDER_ITEM_NO_HEADERS=["item no", "sl no", "s no", "sr no", "item number"]
TENDER_ITEM_TITLE_HEADERS=["item title", "item name"]
TENDER_ITEM_DESCRIPTION_HEADERS=["description", "descriptions", "specification", "specifications", "critical dimension"]
# File roles a tender's items come from, in this order; then the bid's item category row
TENDER_ITEM_LIST_ROLES=["boq_items"]
TENDER_SPEC_ROLES=["boq_spec", "buyer_spec", "gem_category_spec", "buyer_doc", "attachment"]
TENDER_ITEM_CATEGORY_LABELS=["item category"]
# Name and value labels of a GeM category specification row ("Specification Name: Head; Bid
# Requirement (Allowed Values): 14.0 (meter)"). A tender with one nearly empty item gets these
# rows as its requirements, read as "Head : 14.0 (meter)"
TENDER_SPEC_ROW_LABELS=["Specification Name","Bid Requirement (Allowed Values)"]
# An item listed by a code ("PY9756306157") takes the one table row keyed by that code
# ("Material Code: PY9756306157; Range: ...; Thermowell Material: ..."). A code is one unbroken
# run of letters and digits at least this long; the row needs this many other labelled cells.
TENDER_ITEM_CODE_MIN_LENGTH=8
TENDER_ITEM_CODE_ROW_MIN_CELLS=3
# Title-only items take the spec table row numbered like them; fewest words of its description
TENDER_NUMBERED_ROW_MIN_WORDS=5
# GeM bid rows: the BOQ title, and the GeM categories the buyer selected (searched first on GeM)
TENDER_BOQ_TITLE_LABELS=["BOQ Title"]
TENDER_BUYER_CATEGORY_LABELS=["Relevant Categories selected for notification"]
# A BOQ title with one of these words is a spare-parts tender (notice + OEM on the report)
TENDER_SPARE_PARTS_WORDS=["spare","spares"]
TENDER_ITEM_QUANTITY_HEADERS=["quant", "qty"]
TENDER_ITEM_UNIT_HEADERS=["unit", "uom"]
# A "KEY : value" line's key has at most this many words
TENDER_LABEL_MAX_WORDS=6
# Values this short with no code in them ("WAFER") are options; longer ones are free text
TENDER_ENUM_MAX_WORDS=2
# Longest key inside a value ("MATERIAL: Body: WCB"), in words
TENDER_INLINE_KEY_MAX_WORDS=3

# ---- Backend: rule comparator ----
# Label words asking what the item is ("Valve Type : Globe Valve"): met by the catalogue chosen for that product
PRODUCT_TYPE_LABEL_WORDS=["type", "product"]
# Label words that do not name the attribute ("VALVE BODY MOC" -> body); used without an ontology
COMPARATOR_GENERIC_LABEL_WORDS=["valve", "moc", "material", "of", "construction", "type", "the", "for", "and", "max", "maximum", "min", "minimum", "range", "at"]
# Words ignored when comparing codes ("ASTM A216 Gr. WCB" -> a216, wcb)
COMPARATOR_CODE_NOISE_WORDS=["astm", "asme", "gr", "grade", "type", "or", "and", "equivalent", "equivelent", "eqv", "with", "of", "the", "to", "as", "per", "edition", "latest", "revision", "rev"]
# An unlabelled catalogue line starting with one of these states a condition, not a value
# ("For sizes 6" and above, lifting eyebolt option"): it never decides a requirement
COMPARATOR_CONDITION_WORDS=["for", "if", "when", "where"]
# Designations written before their number ("PN 16", "DN 50")
COMPARATOR_DESIGNATION_PREFIXES=["pn", "class", "dn", "nb"]
# A table whose header or section names one of these is a dimension table: its numbers never
# decide a size, flow or other numeric requirement
COMPARATOR_DIMENSION_WORDS=["dimension", "dimensions", "weight", "wt", "face to face"]
# A catalogue page with a section naming one of these lists what can be ordered
CATALOGUE_OPTION_SECTIONS=["ordering information", "how to order", "ordering code"]
# ... and so is a table with at least this many one-letter columns (A, B, H: drawing callouts)
COMPARATOR_DIMENSION_MIN_LETTER_COLUMNS=2
# A line of an interleaved table cell keeps the row key only within this many points.
COMPARATOR_LINE_Y_TOLERANCE=2.0
# Relative tolerance for numeric comparison after unit conversion
COMPARATOR_REL_TOLERANCE=0.001
# A catalogue value this short without codes ("Flanged") states an option; a longer one without
# codes is a sentence and never makes a requirement missing
COMPARATOR_VALUE_MAX_WORDS=4
# A catalogue field saying one of these only offers the value (C7): a full match becomes partial
COMPARATOR_OPTIONAL_MARKERS=["optional","on request","upon request","on demand"]
# Evidence rows kept per requirement and manufacturer
COMPARATOR_MAX_EVIDENCE=3
# Every piece of a cited quote must match its page at least this well (normalized fuzzy ratio)
QUOTE_MATCH_THRESHOLD=0.9
# Score per decided status; unsupported / not_applicable are excluded from scores
STATUS_SCORES={"full_match": 1.0, "partial_match": 0.5, "missing_capability": 0.0}
# Manufacturers with less evidence coverage (%) are marked low coverage and ranked after the others
RANKING_MIN_COVERAGE_PCT=50
# Vendors listed per item as its best (catalogue makers and GeM sellers), ranked like the tender
# ranking on that item alone; only vendors with a document and a decided requirement. Each gets a
# match level by rules: needs review (coverage below RANKING_MIN_COVERAGE_PCT, any AI-judge
# decision, or tied catalogues), else full match (all checked met), does not meet spec (none
# met) or partial match (a mix); nothing decided = not checked.
REPORT_TOP_VENDORS_PER_ITEM=6
# Extraction check: a tender matching any rule is "unreliable" and every result needs review.
# An item title this short (no digit, no product) is a fragment.
EXTRACTION_TITLE_FRAGMENT_MAX_WORDS=3
# An item title this long (no product) is running text.
EXTRACTION_TITLE_SENTENCE_MIN_WORDS=25
# Words that make an item title a sentence, never one that is also a code like "IS 6438" (JSON list).
EXTRACTION_TITLE_SENTENCE_WORDS=["shall","must","should","will","are","be"]
# Comma-separated parts of an Item Category row starting with this many same words are several
# products merged into one item, which marks the tender.
EXTRACTION_MERGED_TITLE_LEAD_WORDS=2
# Share of items with such titles that marks the tender.
EXTRACTION_BAD_TITLE_SHARE=0.5
# One item with more atomic requirements than this marks the tender.
EXTRACTION_MAX_ITEM_REQUIREMENTS=50
# OCR pages with a lower mean confidence are low-confidence.
EXTRACTION_OCR_MIN_CONFIDENCE=0.7
# An item with at most this many atomic requirements is nearly empty
EXTRACTION_NEARLY_EMPTY_ITEM=2
# Unreliable if every item is nearly empty while at least this many catalogue-checkable lines are
# general requirements (the specification did not reach the items, seen on pump tenders)
EXTRACTION_MIN_SPEC_OUTSIDE_ITEMS=10
# Unreliable if at least this share of items is nearly empty (title only) although specification
# files (spec/BOQ/annexure roles) are attached: their text did not reach the items
EXTRACTION_TITLE_ONLY_SHARE=0.5
# Share of item requirements citing such pages that marks the tender.
EXTRACTION_LOW_OCR_SHARE=0.2
# A catalogue page naming this many products is an overview: it holds no one model's values
CATALOGUE_OVERVIEW_MIN_HEADINGS=3
# A page's first line is a product title (documents with several product types only) when its
# lead, up to a dash, colon or bracket, has at most this many words and names one product type.
CATALOGUE_PAGE_TITLE_MAX_WORDS=5

# ---- Backend: LLM ----
# gemini | groq. With groq use e.g. LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Secret. Needed by every command that calls the LLM when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# Secret. Needed when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
# Longest wait honoured from a rate-limit (429) retry-after header, seconds
LLM_MAX_RETRY_AFTER_SECONDS=90
# ---- Backend: confidence (1.0 times the factor of each weakness found) ----
CONFIDENCE_LLM_FACTOR=0.7
# All evidence of a result comes from brochures
CONFIDENCE_BROCHURE_FACTOR=0.85
# All evidence of a result comes from GeM Marketplace listings (seller-declared; below brochures).
# Such results always need review, whatever their confidence.
CONFIDENCE_GEM_LISTING_FACTOR=0.6
# A cited page was OCR'd
CONFIDENCE_OCR_FACTOR=0.8
# The judge's passage was accepted by search only because it holds a requirement code
CONFIDENCE_CODE_ONLY_FACTOR=0.8
# A rule flag: near miss, misread, unclear product heading, tied catalogues
CONFIDENCE_FLAG_FACTOR=0.8
# Decided results below this go to review
CONFIDENCE_REVIEW_THRESHOLD=0.75

# API runs send free-text requirements to the LLM judge (the CLI uses match-tender --judge).
# On by default; without GEMINI_API_KEY runs are rules only and the log says so. false = rules only
LLM_JUDGE_ENABLED=true
# Most judge calls for one tender; the rest stay unsupported. Caps the cost: a call is about Rs 0.10
LLM_JUDGE_MAX_CALLS=35
# Best catalogue passages sent to the judge per requirement (fewer = cheaper prompts)
LLM_JUDGE_MAX_PASSAGES=5
# Gemini thinkingLevel of judge calls; "low" adds no hidden (billed) thinking tokens. Empty = model default
LLM_JUDGE_THINKING_LEVEL=low
# Judge failures in a row before a run stops calling; the rest stay unsupported
LLM_JUDGE_MAX_FAILURES=3
# LLM judge calls at a time (1 = one by one); searches stay one by one. Results do not depend on it
LLM_JUDGE_WORKERS=4
# When the right product's passages all score below RERANK_MIN_SCORE, this many of the best go to
# the judge instead of ending unsupported; its quote must still verify (0 turns it off)
LLM_JUDGE_LOW_SCORE_HITS=3
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=16384
LLM_TIMEOUT_SECONDS=120
# Retries after a rate limit, server error or network failure; the delay doubles each time
LLM_MAX_RETRIES=4
LLM_RETRY_BACKOFF_SECONDS=2
# Chunks sent to the LLM in one spec-extraction call
SPEC_EXTRACT_BATCH_CHUNKS=25

# ---- Backend: embeddings ----
# Local sentence-transformers model (downloaded once to the Hugging Face cache). Vectors are
# 1024-d; a model with another size needs a migration of text_embeddings.embedding.
EMBEDDING_MODEL=BAAI/bge-m3
# auto | cpu | cuda  (auto = GPU if a CUDA build of PyTorch sees one)
EMBEDDING_DEVICE=auto
# Half precision on the GPU (halves GPU memory; ignored on CPU)
EMBEDDING_FP16=true
EMBEDDING_BATCH_SIZE=16
# Chunks are at most ~500 tokens, so 512 never cuts a chunk
EMBEDDING_MAX_TOKENS=512

# ---- Backend: retrieval (starting values; tuned with the eval in plan step 15) ----
# Tender words of at least QUERY_TYPO_MIN_LENGTH letters within this edit distance of an
# ontology word are corrected ("buterfly" -> "butterfly"); 0 turns correction off
QUERY_TYPO_MAX_DISTANCE=2
QUERY_TYPO_MIN_LENGTH=5
# Okapi BM25 parameters over chunk search_text
BM25_K1=1.5
BM25_B=0.75
# Candidates from each of BM25 and dense search, fused with weighted reciprocal rank fusion
RETRIEVAL_CANDIDATES=50
# Dense search over the filtered chunks: exact (every vector) | hnsw (pgvector index, approximate)
DENSE_SEARCH=exact
# HNSW only: candidate list size (higher = better recall, slower)
HNSW_EF_SEARCH=100
RRF_K=60
RRF_BM25_WEIGHT=1.0
# 0 = BM25 only
RRF_DENSE_WEIGHT=0.7
# Cross-encoder reranker (English MiniLM, ~90 MB, downloaded once to the Hugging Face cache).
# Beat BAAI/bge-reranker-v2-m3 on a labelled tender (correct chunk first 10/13 vs 6/13).
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# auto | cpu | cuda
RERANKER_DEVICE=auto
# Half precision on the GPU, for large rerankers (ignored on CPU)
RERANKER_FP16=false
RERANKER_BATCH_SIZE=32
RERANKER_MAX_TOKENS=512
# Chunks kept after reranking, and the 0-1 score the best one needs (else: insufficient evidence)
RERANK_TOP_K=5
RERANK_MIN_SCORE=0.3
# Best fused candidates sent to the reranker (0 = all; the slowest step of a judge search on CPU)
RERANK_CANDIDATES=20

# ---- Backend: section categories ----
# Heading/text phrases that sort chunks into categories (costing, eligibility, dimensions, ...)
SECTION_CATEGORIES_FILE=config/section_categories.yaml
# Phrases that classify a tender line: vague, mandatory, named make, ...
REQUIREMENT_RULES_FILE=config/requirement_rules.yaml

# ---- Backend: tender link fetcher ----
# URL patterns: which links found in bid.pdf are fetched (spec, BOQ, ATC, ...) or skipped (GTC)
TENDER_LINK_RULES_FILE=config/tender_links.yaml
# How many hops from bid.pdf to follow links (attachments can link further documents)
TENDER_LINK_MAX_DEPTH=3
HTTP_TIMEOUT_S=60
# Linked files larger than this are refused
HTTP_MAX_DOWNLOAD_MB=100
# Largest bid.pdf the API accepts (MB)
TENDER_UPLOAD_MAX_MB=50
# Most runs GET /runs returns
RUNS_LIST_LIMIT=100
# Longest failure reason kept on a run (characters)
RUN_ERROR_MAX_CHARS=2000
# Where runs execute: thread = inside the API process (dev); rq = Redis queue + worker process
# (`python -m app.workers.worker`; docker compose runs one). RQ runs survive an API restart.
JOB_QUEUE_BACKEND=thread
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=runs
# A run taking longer than this (seconds) is stopped and marked failed (rq only)
RQ_JOB_TIMEOUT_S=3600
HTTP_USER_AGENT=tender-matcher/0.1 (+document fetcher)

# ---- Backend: GeM Marketplace discovery (off by default) ----
# On: a finished run lists item product types no manufacturer document covers, with a button that
# reads GeM Marketplace listings for that type and re-matches those items by rules (no LLM). The
# listings are seller-declared: their results are marked so and always need review.
DISCOVERY_ENABLED=false
# With discovery on, every run also searches GeM for all its item types while the catalogues are
# matched, and waits for it at most GEM_RUN_BUDGET_SECONDS from the run's start (later types
# arrive as a child run).
GEM_IN_RUN=true
# Also search items naming no valve/pump type, by title words (any tender gets GeM vendors when
# the database has nothing for an item); types with nothing in the database are searched first
GEM_IN_RUN_TITLE_KEYS=true
# Words that may follow a title key in a GeM category name, besides filler words, codes and the
# tender's own title words ("Foot Valves IS 4038" fits foot valve; "Switch Disconnectors" is no switch)
GEM_CATEGORY_TAIL_WORDS=["conforming","confirming","according","compliant","is","iso","en","din","astm","bs","api","ansi","asme","iec"]
# Recommended GeM vendors: listings of the buyer's GeM categories (tender) and related ones per item
GEM_RECOMMENDED_PER_CATEGORY=5
GEM_RELATED_PER_ITEM=3
# Words too general to relate an item to a buyer category (equipment names, part-of words)
GEM_RELATED_IGNORE_WORDS=["pump","pumps","pumpset","valve","valves","motor","motors","assembly","assemblies","unit","units","part","parts","stage","type","complete"]
# Each GeM check of a run in its own process (storing listings is CPU work)
GEM_CHECK_IN_PROCESS=true
GEM_RUN_BUDGET_SECONDS=180
# Product type -> GeM category slugs (category pages list products in plain HTML; search does not)
GEM_MARKETPLACE_FILE=config/gem_marketplace.yaml
GEM_BASE_URL=https://mkp.gem.gov.in
# A check searches GeM with the words of the items of that type (/search?q=..., plain HTML) and
# reads at most GEM_MAX_CATEGORIES fitting categories (hand-listed ones only if none is found).
GEM_MAX_CATEGORIES=4
# Result pages read per category (12 products each). The listings to open are ranked over all of
# them, per tender item: the item's sub-type first (knife gate vs wedge gate), then its size in mm
# ("200MM" = "Size 200 millimeter" = DN 200 = 8 inch; a bare number is no size), then item title
# words, then how the product is sold (seller_rank in config/gem_marketplace.yaml: OEM before
# authorised reseller), seller rating, vendor assessment. Items pick in turns, so each gets its
# best listings; at most GEM_MAX_LISTINGS_PER_BRAND per brand. A brand typed as a placeholder
# ("NA", see empty_values in config/gem_marketplace.yaml) counts as no brand (Unbranded).
GEM_MAX_CATEGORY_PAGES=6
GEM_MAX_LISTINGS_PER_BRAND=2
# Items whose title names no ontology product type are offered too: GeM is searched by a key
# from the title ("PVC foot valve Ball type" -> foot_valve, an ontology other product; else the
# first run of at most GEM_TITLE_KEY_MAX_WORDS product words, without filler words, sizes or
# codes). A GeM category fits when it holds the key words in order, only filler words between.
# Listings found are stored in category GEM_UNTYPED_CATEGORY.
GEM_UNTYPED_CATEGORY=general
GEM_TITLE_KEY_MAX_WORDS=3
GEM_TITLE_STOP_WORDS=["supply","supplying","providing","procurement","purchase","of","for","the","and","or","as","per","to","in","on","new","complete","set","nos","no","item","items","type","make","model","size","spare","spares","with"]
# Most new product pages read per check (already stored ones are free); pause (seconds) before every request. robots.txt is obeyed,
# HTTP_USER_AGENT is sent, nothing logs in.
GEM_MAX_LISTINGS=20
GEM_REQUEST_DELAY_SECONDS=1
# A listing with fewer specification rows (after dropping "NA" rows) is not kept
GEM_MIN_SPEC_ROWS=5
# File store folder for the frozen HTML of each listing read (data/gem_snapshots; never committed)
GEM_SNAPSHOT_PREFIX=gem_snapshots

# ---- Backend: chunking ----
# Prose chunks aim for TARGET tokens, never exceed MAX, and repeat OVERLAP tokens between chunks.
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
# Text blocks longer than this many words are never treated as section headings
CHUNK_HEADING_MAX_WORDS=10
# Headings must be at least this share Latin letters (GeM PDFs extract Hindi as broken glyphs)
CHUNK_HEADING_MIN_LATIN_RATIO=0.5
# Lines whose letters+digits are more than this share digits are codes ("3PHMP-05-2018-01"),
# never headings
CHUNK_HEADING_MAX_DIGIT_SHARE=0.6
# Top/bottom share of a PDF page where running headers and footers sit. A heading in the
# bottom band does not carry over to the next page ("A Kirloskar Group Company").
PAGE_MARGIN_BAND_FRACTION=0.12
# A margin line repeated on >= RATIO of pages (and >= MIN_PAGES pages) is boilerplate: dropped
# from chunks, never a heading. Page text keeps it (quotes are verified against it).
BOILERPLATE_MIN_PAGE_RATIO=0.5
BOILERPLATE_MIN_PAGES=2
# Lines with fewer letters than this (page numbers, lone digits) are never boilerplate
BOILERPLATE_MIN_LETTERS=3
# Table header words that mark the model column (JSON list, case-insensitive whole words).
# Not "size" or "type": those columns hold sizes and product types, never model names.
CHUNK_MODEL_HEADER_KEYWORDS=["model"]
# First words of header labels that mark version columns ("Materials WCB/ WCC", "Materials LCB/
# LCC"). Two or more -> one chunk per row and version, version stored as the chunk's model.
CHUNK_VARIANT_HEADER_KEYWORDS=["material", "materials", "specification"]

# ---- Backend: OCR (scanned pages) ----
OCR_ENABLED=true
# A page is OCR'd only if its text layer has fewer than this many non-space characters...
OCR_MIN_TEXT_CHARS=50
# ...AND images cover at least this fraction of the page (so sparse cover pages keep their text)
OCR_MIN_IMAGE_COVERAGE=0.5
OCR_DPI=300
# A page with this many control characters prints a shifted font ("9QTMKPI VGORGTCVWTG" =
# "Working temperature", seen in the L&T API 600 catalogue): its text is decoded
SHIFTED_TEXT_MIN_CONTROL_CHARS=5
# A one-word token without a control character ("2CTCOGVGT" = "Parameter") is decoded only if it
# has this many letters and this share of vowels once decoded; codes such as "ASTM" stay
SHIFTED_WORD_MIN_LETTERS=4
SHIFTED_WORD_MIN_VOWEL_SHARE=0.3
# Tesseract languages; 'eng' must come first (hin first garbles spec codes like SS316)
OCR_LANGUAGE=eng+hin
# Full path to tesseract.exe if it is not on PATH (Windows default shown)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Folder with eng/hin/osd .traineddata, if not Tesseract's own (no spaces allowed)
# TESSDATA_DIR=C:/Users/<you>/AppData/Local/tessdata
# Tesseract --psm for scanned tender pages: 4 reads a table row by row (3 is Tesseract's own default)
OCR_TENDER_PAGE_SEGMENTATION=4
# Scanned tender tables are rebuilt as label | value rows from OCR word boxes:
# a gap wider than this many word heights separates two cells
OCR_TABLE_CELL_GAP_FACTOR=2.5
# A row never grows taller than this many word heights; taller words (merged serial numbers) are noise
OCR_TABLE_MAX_ROW_HEIGHT_FACTOR=2.0
# Fewest lines with two or more cells that make a table
OCR_TABLE_MIN_ROWS=3
# A cell with at most this many letters/digits is short (a serial number)
OCR_TABLE_SERIAL_MAX_CHARS=3
# A one-cell line wider than this fraction of the page's text ends a table
OCR_TABLE_PROSE_WIDTH_FRACTION=0.6
# Rebuild only if at most this share of lines has three or more cells (wider tables keep the OCR text)
OCR_TABLE_MAX_WIDE_SHARE=0.25
# Rebuild only if at least this share of rows has a label (size or quantity lists do not)
OCR_TABLE_MIN_LABELLED_SHARE=0.6
# Scanned rows read below this mean word confidence send their requirements to review
OCR_ROW_MIN_CONFIDENCE=0.6
# OCR look-alike characters (JSON); a token is repaired only into an exact ontology code (55304 -> SS304)
# OCR_CODE_CONFUSIONS={"5": "s", "s": "5", "0": "o", "o": "0", "1": "li", "l": "1", "i": "1", "8": "b", "b": "8"}

# ---- docker-compose: db service ----
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender_matcher
POSTGRES_PORT=5433

# ---- Tests ----
# DB the test suite migrates and uses (created automatically if missing). Tests that need it
# are skipped with a clear reason if it is unreachable.
TEST_DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5433/tender_matcher_test

# ---- Frontend (Vite; copy these into frontend/.env; names must start with VITE_) ----
# API prefix the browser calls; the dev server proxies it to the backend
VITE_API_BASE_URL=/api/v1
# Backend the Vite dev server proxies /api to
VITE_BACKEND_ORIGIN=http://localhost:8000
